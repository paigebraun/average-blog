---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ClientRouter } from "astro:transitions";

type Props = CollectionEntry<"blog">["data"];

const { title, description, heroImage, author } = Astro.props;
const headingClass = title?.toLowerCase().startsWith("issue")
    ? "font-issue-heading"
    : "font-heading";

// Determine if this is the issue landing page
const isIssueLandingPage =
    Astro.props.issue && Astro.url.pathname === `/${Astro.props.issue}/`;
---

<html lang="en">
    <head>
        <BaseHead title={title} description={description} />
        <ClientRouter />
        <!-- Google tag (gtag.js) -->
        <script
            is:inline
            src="https://www.googletagmanager.com/gtag/js?id=G-2D4PERVE1N"
        ></script>
        <script>
            declare global {
                interface Window {
                    dataLayer: Record<string, any>[];
                    gtag: (...args: any[]) => void;
                }
            }
            document.addEventListener("astro:page-load", () => {
                window.dataLayer = window.dataLayer || [];
                window.gtag = function gtag(...args: any[]) {
                    window.dataLayer.push(arguments);
                };
                window.gtag("js", new Date());
                window.gtag("consent", "default", {
                    ad_storage: "denied",
                    ad_user_data: "denied",
                    ad_personalization: "denied",
                    analytics_storage: "denied",
                });
                window.gtag("config", "G-2D4PERVE1N");
            });
        </script>
    </head>

    <body
        class="font-display flex flex-col min-h-dvh max-w-prose m-auto px-4 dark:bg-zinc-900 dark:text-white">
        <Header />
        <main class="flex-1">
            {
                Astro.props.issue && !isIssueLandingPage && (
                    <a
                        href={`/${Astro.props.issue}/`}
                        class="inline-flex items-center gap-2 text-sm font-issue-heading mb-4 text-zinc-600 dark:text-zinc-400 hover:text-zinc-800 dark:hover:text-zinc-200">
                        <span
                            aria-hidden="true"
                            class="font-display mt-[0.125rem]">
                            ←
                        </span>
                        {Astro.props.issue.replace("-", " ")}
                    </a>
                )
            }
            <article>
                <div class="hero-image">
                    {
                        heroImage && (
                            <img
                                class="w-full h-[410px] object-cover grayscale"
                                height={410}
                                src={heroImage}
                                alt=""
                            />
                        )
                    }
                </div>
                <div class="prose dark:prose-invert">
                    <div>
                        <h1 class={`${headingClass} mt-6 mb-0`}>{title}</h1>
                        {
                            description && (
                                <p class="m-0 text-zinc-600 dark:text-zinc-400 text-xl">
                                    {description}
                                </p>
                            )
                        }
                        {
                            author && (
                                <p class="m-0 italic text-zinc-600 dark:text-zinc-400">
                                    By {author}
                                </p>
                            )
                        }
                        <hr class="mt-[2rem] mb-[2rem]" />
                    </div>
                    <slot />
                </div>
            </article>
        </main>
        <Footer />
    </body>
</html>
