---
import HeaderLink from "./HeaderLink.astro";
import { SITE_TITLE } from "../consts";
---

<header>
    <nav class="flex justify-between">
        <div class="flex gap-4 my-16">
            <a href="/average-blog/">
                <img
                    class="w-28 h-28 block dark:hidden"
                    src="/average-blog/Logo_Transparent.png"
                    alt="avrg logo"
                />
                <img
                    class="w-28 h-28 hidden dark:block"
                    src="/average-blog/Logo_Transparent_White.png"
                    alt="avrg logo"
                />
            </a>

            <div class="flex flex-col justify-between">
                <div>
                    <h2 class="text-2xl font-heading">
                        <a>{SITE_TITLE}</a>
                    </h2>
                    <p class="text-zinc-600 dark:text-zinc-400">
                        Empower the average runner.
                    </p>
                </div>

                <div class="flex items-center gap-4 mb-2">
                    <HeaderLink href="/average-blog/">Releases</HeaderLink>
                    <div class="h-5 w-px bg-zinc-300 dark:bg-white/15"></div>
                    <HeaderLink href="/average-blog/about">About</HeaderLink>
                </div>
            </div>
        </div>
    </nav>
</header>
