---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { getCollection } from "astro:content";

const issues = (await getCollection("issues")).sort((a, b) => {
    const orderA = a.data.order !== undefined ? a.data.order.valueOf() : 0;
    const orderB = b.data.order !== undefined ? b.data.order.valueOf() : 0;
    return orderB - orderA;
});
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
        <!-- Google tag (gtag.js) -->
        <script
            is:inline
            src="https://www.googletagmanager.com/gtag/js?id=G-2D4PERVE1N"
        ></script>
        <script>
            declare global {
                interface Window {
                    dataLayer: Record<string, any>[];
                    gtag: (...args: any[]) => void;
                }
            }
            document.addEventListener("astro:page-load", () => {
                window.dataLayer = window.dataLayer || [];
                window.gtag = function gtag(...args: any[]) {
                    window.dataLayer.push(arguments);
                };
                window.gtag("js", new Date());
                window.gtag("consent", "default", {
                    ad_storage: "denied",
                    ad_user_data: "denied",
                    ad_personalization: "denied",
                    analytics_storage: "granted",
                });
                window.gtag("config", "G-2D4PERVE1N");
            });
        </script>
    </head>
    <body
        class="font-display flex flex-col min-h-dvh max-w-prose m-auto px-4 dark:bg-zinc-900 dark:text-white">
        <Header />
        <main class="flex-1">
            <section>
                <ul>
                    {
                        issues.map((issue) => (
                            <li class="mb-8">
                                <a href={`/${issue.slug}/`}>
                                    <h1 class="font-issue-heading text-xl font-bold hover:underline">
                                        {issue.data.title}
                                    </h1>
                                </a>
                                <p class="mb-2 text-zinc-600 dark:text-zinc-400">
                                    {issue.data.description}
                                </p>
                                <a
                                    href={`/${issue.slug}/`}
                                    class="hover:font-medium inline-flex items-center gap-2">
                                    Check it out
                                    <span
                                        aria-hidden="true"
                                        class="font-display mt-[0.125rem]">
                                        →
                                    </span>
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </section>
        </main>
        <Footer />
    </body>
</html>
