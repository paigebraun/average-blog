---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { getCollection } from "astro:content";

const issues = (await getCollection("issues")).sort((a, b) => {
    const orderA = a.data.order !== undefined ? a.data.order.valueOf() : 0;
    const orderB = b.data.order !== undefined ? b.data.order.valueOf() : 0;
    return orderB - orderA;
});
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body
        class="font-display flex flex-col min-h-screen max-w-prose m-auto px-4 dark:bg-zinc-900 dark:text-white">
        <Header />
        <main class="flex-1">
            <section>
                <ul>
                    {
                        issues.map((issue) => (
                            <li class="mb-8">
                                <a href={`/average-blog/${issue.slug}/`}>
                                    <h1 class="font-issue-heading text-xl font-bold hover:underline">
                                        {issue.data.title}
                                    </h1>
                                </a>
                                <p class="mb-2 text-zinc-600 dark:text-zinc-400">
                                    {issue.data.description}
                                </p>
                                <a
                                    href={`/average-blog/${issue.slug}/`}
                                    class="hover:font-medium inline-flex items-center gap-2">
                                    Check it out
                                    <span
                                        aria-hidden="true"
                                        class="font-display mt-[0.125rem]">
                                        →
                                    </span>
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </section>
        </main>
        <Footer />
    </body>
</html>
